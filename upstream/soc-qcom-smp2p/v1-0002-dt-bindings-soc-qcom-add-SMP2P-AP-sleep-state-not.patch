From 34e93484ea58c05aeec7af58ea0ddc09c3bcaf46 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Thu, 1 Oct 2026 00:25:02 +0200
Subject: [PATCH v1 2/3] dt-bindings: soc: qcom: add SMP2P AP sleep state
 notifier
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Document the qcom,smp2p-sleepstate consumer node. The driver publishes
the application processor's sleep state on an outbound "sleepstate"
SMP2P entry and takes an interrupt from the remote "sleepstate_see"
entry. The ADSP sensor framework (SEE) on some platforms, e.g. SM7125,
faults on system suspend without it.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 .../soc/qcom/qcom,smp2p-sleepstate.yaml       | 50 +++++++++++++++++++
 1 file changed, 50 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/qcom/qcom,smp2p-sleepstate.yaml

diff --git a/Documentation/devicetree/bindings/soc/qcom/qcom,smp2p-sleepstate.yaml b/Documentation/devicetree/bindings/soc/qcom/qcom,smp2p-sleepstate.yaml
new file mode 100644
index 000000000000..0f753b77c17e
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/qcom/qcom,smp2p-sleepstate.yaml
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/qcom/qcom,smp2p-sleepstate.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SMP2P AP sleep state notifier
+
+maintainers:
+  - Miroslav Mráz <miroslav.mraz@techmania.cz>
+
+description:
+  Publishes whether the application processor is suspended on the "sleepstate"
+  SMP2P entry of an edge (typically the ADSP). The sensor DSP watches this bit
+  to control its suspend/resume behaviour. The remote can in turn raise its
+  "sleepstate_see" entry to request that the AP stay awake briefly, which is
+  delivered to this device as an interrupt.
+
+properties:
+  compatible:
+    const: qcom,smp2p-sleepstate
+
+  qcom,smem-states:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    items:
+      - items:
+          - description: phandle to the outbound "sleepstate" SMP2P entry
+          - description: the AP-awake bit within that entry
+    description: The outgoing SMP2P entry carrying the AP sleep state.
+
+  interrupts:
+    maxItems: 1
+    description: Incoming interrupt from the remote "sleepstate_see" entry.
+
+required:
+  - compatible
+  - qcom,smem-states
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    smp2p-sleepstate {
+        compatible = "qcom,smp2p-sleepstate";
+        qcom,smem-states = <&sleepstate_smp2p_out 12>;
+        interrupts-extended = <&sleepstate_smp2p_in 0 IRQ_TYPE_EDGE_RISING>;
+    };
-- 
