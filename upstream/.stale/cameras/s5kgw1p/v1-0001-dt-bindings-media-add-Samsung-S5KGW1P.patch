From 2bd1a8058b3f83b5f13d0857123c891758a58f22 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Thu, 1 Oct 2026 00:19:01 +0200
Subject: [PATCH v1 1/2] dt-bindings: media: add Samsung S5KGW1P
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Samsung S5KGW1P (ISOCELL GW1) is a 64MP CMOS image sensor controlled
over I2C and streaming RAW10 over a 3-trio MIPI CSI-2 C-PHY interface. It
is the main camera of the Samsung Galaxy A52 4G (a52q, SM7125). Add a
device tree binding for it.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 .../bindings/media/i2c/samsung,s5kgw1p.yaml   | 112 ++++++++++++++++++
 MAINTAINERS                                   |   6 +
 2 files changed, 118 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/samsung,s5kgw1p.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/samsung,s5kgw1p.yaml b/Documentation/devicetree/bindings/media/i2c/samsung,s5kgw1p.yaml
new file mode 100644
index 000000000000..12ae83b7d033
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/samsung,s5kgw1p.yaml
@@ -0,0 +1,112 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/samsung,s5kgw1p.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S5KGW1P Image Sensor
+
+maintainers:
+  - Miroslav Mráz <miroslav.mraz@techmania.cz>
+
+description:
+  The Samsung S5KGW1P (ISOCELL GW1) is a 1/1.72-inch 64MP CMOS active pixel
+  digital image sensor with a Tetracell colour filter array. It is programmable
+  through an I2C interface and outputs image data over a 3-trio MIPI CSI-2
+  C-PHY interface.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: samsung,s5kgw1p
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK supply clock.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to the RESET pad of the sensor.
+    maxItems: 1
+
+  vana-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  vdig-supply:
+    description: Digital core voltage supply, 1.05 volts.
+
+  vio-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  vaf-supply:
+    description: Autofocus actuator voltage supply, 2.8 volts.
+
+  vcustom-supply:
+    description: Sensor-specific auxiliary voltage supply.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 4
+
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+
+        required:
+          - bus-type
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@2d {
+            compatible = "samsung,s5kgw1p";
+            reg = <0x2d>;
+            clocks = <&camera_mclk 0>;
+            reset-gpios = <&tlmm 21 GPIO_ACTIVE_LOW>;
+            vana-supply = <&vreg_2p8>;
+            vdig-supply = <&vreg_1p05>;
+            vio-supply = <&vreg_1p8>;
+            vaf-supply = <&vreg_af_2p8>;
+            vcustom-supply = <&vreg_custom>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csiphy0_ep>;
+                    bus-type = <4>;
+                    data-lanes = <1 2 3>;
+                    link-frequencies = /bits/ 64 <1000000000>;
+                };
+            };
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index ebc492571b0c..3877d98fa5b9 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -24396,6 +24396,12 @@ M:	Andrzej Hajda <andrzej.hajda@intel.com>
 S:	Supported
 F:	drivers/media/i2c/s5k5baf.c
 
