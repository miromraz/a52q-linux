From 10d970f64dc47de90d58da4419a325e3e63136d6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Thu, 1 Oct 2026 00:19:00 +0200
Subject: [PATCH v1 1/2] dt-bindings: media: add Sony IMX616
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Sony IMX616 is a 1/2.8" 32MP CMOS image sensor with a Quad Bayer
colour filter array, controlled over I2C and streaming RAW10 over a
4-lane MIPI CSI-2 D-PHY interface. It is the front camera of the Samsung
Galaxy A52 4G (a52q, SM7125). Add a device tree binding for it.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 .../bindings/media/i2c/sony,imx616.yaml       | 99 +++++++++++++++++++
 MAINTAINERS                                   |  6 ++
 2 files changed, 105 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/sony,imx616.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/sony,imx616.yaml b/Documentation/devicetree/bindings/media/i2c/sony,imx616.yaml
new file mode 100644
index 000000000000..e307ab1c6123
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/sony,imx616.yaml
@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx616.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX616 Image Sensor
+
+maintainers:
+  - Miroslav Mráz <miroslav.mraz@techmania.cz>
+
+description:
+  The Sony IMX616 is a 1/2.8-inch 32MP CMOS active pixel digital image sensor
+  with a Quad Bayer colour filter array. It is programmable through an I2C
+  interface and outputs image data over a 4-lane MIPI CSI-2 D-PHY interface.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx616
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK supply clock.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to the XCLR reset pad of the sensor.
+    maxItems: 1
+
+  vana-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  vdig-supply:
+    description: Digital core voltage supply, 1.1 volts.
+
+  vio-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@1a {
+            compatible = "sony,imx616";
+            reg = <0x1a>;
+            clocks = <&camera_mclk 0>;
+            reset-gpios = <&tlmm 92 GPIO_ACTIVE_LOW>;
+            vana-supply = <&vreg_2p8>;
+            vdig-supply = <&vreg_1p1>;
+            vio-supply = <&vreg_1p8>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csiphy2_ep>;
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <516000000>;
+                };
+            };
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index 72294ddfa5b7..d02b1a55c2d8 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
