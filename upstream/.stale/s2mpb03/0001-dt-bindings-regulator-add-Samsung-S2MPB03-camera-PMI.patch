From 260ad9bd88a717f174ed35b4273d16039ac17c4a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Tue, 29 Sep 2026 22:08:08 +0200
Subject: [PATCH 1/2] dt-bindings: regulator: add Samsung S2MPB03 camera PMIC
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Samsung S2MPB03 is a camera power management IC with seven LDO
regulators controlled over I2C. It is used on boards such as the
Samsung Galaxy A52 (SM7125).

No public datasheet is available; the binding follows the register
layout used by the Samsung downstream driver.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 .../bindings/regulator/samsung,s2mpb03.yaml   | 67 +++++++++++++++++++
 1 file changed, 67 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/samsung,s2mpb03.yaml

diff --git a/Documentation/devicetree/bindings/regulator/samsung,s2mpb03.yaml b/Documentation/devicetree/bindings/regulator/samsung,s2mpb03.yaml
new file mode 100644
index 000000000000..0650bf7e90df
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/samsung,s2mpb03.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/samsung,s2mpb03.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPB03 camera PMIC
+
+maintainers:
+  - Miroslav Mráz <miroslav.mraz@techmania.cz>
+
+description:
+  The Samsung S2MPB03 is a camera power management IC providing seven LDO
+  regulators controlled over I2C. It is found on boards such as the Samsung
+  Galaxy A52 (SM7125).
+
+properties:
+  compatible:
+    const: samsung,s2mpb03
+
+  reg:
+    maxItems: 1
+
+  regulators:
+    type: object
+    additionalProperties: false
+    description:
+      List of the seven LDO regulators, named after their hardware
+      counterparts ldo1 to ldo7.
+
+    patternProperties:
+      "^ldo[1-7]$":
+        type: object
+        $ref: regulator.yaml#
+        unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - regulators
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        pmic@56 {
+            compatible = "samsung,s2mpb03";
+            reg = <0x56>;
+
+            regulators {
+                ldo1 {
+                    regulator-min-microvolt = <1050000>;
+                    regulator-max-microvolt = <1050000>;
+                };
+
+                ldo3 {
+                    regulator-min-microvolt = <1800000>;
+                    regulator-max-microvolt = <1800000>;
+                };
+            };
+        };
+    };
+...
-- 
