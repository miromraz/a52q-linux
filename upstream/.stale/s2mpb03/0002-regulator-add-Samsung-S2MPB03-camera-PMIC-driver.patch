From a5a50f4ed726979245350274668b2853460f8832 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Tue, 29 Sep 2026 22:08:17 +0200
Subject: [PATCH 2/2] regulator: add Samsung S2MPB03 camera PMIC driver
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Samsung S2MPB03 is a camera power management IC found on boards such
as the Samsung Galaxy A52 (SM7125). It exposes seven LDO regulators over
I2C, each with an enable bit and a 6-bit linear voltage selector in its
LDOn_CTRL register.

No public datasheet is available; the register layout and per-LDO
voltage ranges are taken from the Samsung downstream driver.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 MAINTAINERS                           |   7 ++
 drivers/regulator/Kconfig             |  12 +++
 drivers/regulator/Makefile            |   1 +
 drivers/regulator/s2mpb03-regulator.c | 113 ++++++++++++++++++++++++++
 4 files changed, 133 insertions(+)
 create mode 100644 drivers/regulator/s2mpb03-regulator.c

diff --git a/MAINTAINERS b/MAINTAINERS
index 72294ddfa5b7..509e6cb7a6da 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -24356,6 +24356,13 @@ F:	drivers/rtc/rtc-s5m.c
 F:	include/dt-bindings/regulator/samsung,s2m*.h
 F:	include/linux/mfd/samsung/
 
+SAMSUNG S2MPB03 CAMERA PMIC REGULATOR DRIVER
+M:	Miroslav Mráz <miroslav.mraz@techmania.cz>
+L:	linux-samsung-soc@vger.kernel.org
+S:	Maintained
+F:	Documentation/devicetree/bindings/regulator/samsung,s2mpb03.yaml
+F:	drivers/regulator/s2mpb03-regulator.c
+
 SAMSUNG S3C24XX/S3C64XX SOC SERIES CAMIF DRIVER
 M:	Sylwester Nawrocki <sylvester.nawrocki@gmail.com>
 L:	linux-samsung-soc@vger.kernel.org
diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index 89789ac7a786..0134bc0fb094 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -1460,6 +1460,18 @@ config REGULATOR_S2MPA01
 	 This driver controls Samsung S2MPA01 voltage output regulator
 	 via I2C bus. S2MPA01 has 10 Bucks and 26 LDO outputs.
 
+config REGULATOR_S2MPB03
+	tristate "Samsung S2MPB03 camera PMIC regulators"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  This driver controls the seven LDO regulators of the Samsung
+	  S2MPB03 camera power management IC over I2C. It is found on boards
+	  such as the Samsung Galaxy A52 (SM7125).
+
+	  This driver can also be built as a module. If so, the module will
+	  be called s2mpb03-regulator.
+
 config REGULATOR_S2MPS11
 	tristate "Samsung S2MPS11/13/14/15/S2MPU02/05 voltage regulator"
 	depends on MFD_SEC_CORE || COMPILE_TEST
diff --git a/drivers/regulator/Makefile b/drivers/regulator/Makefile
index 5a764cec8df8..c6cc9c7e4e51 100644
--- a/drivers/regulator/Makefile
+++ b/drivers/regulator/Makefile
@@ -168,6 +168,7 @@ obj-$(CONFIG_REGULATOR_RTQ6752)	+= rtq6752-regulator.o
 obj-$(CONFIG_REGULATOR_RTQ2208) += rtq2208-regulator.o
 obj-$(CONFIG_REGULATOR_S2DOS05) += s2dos05-regulator.o
 obj-$(CONFIG_REGULATOR_S2MPA01) += s2mpa01.o
+obj-$(CONFIG_REGULATOR_S2MPB03) += s2mpb03-regulator.o
 obj-$(CONFIG_REGULATOR_S2MPS11) += s2mps11.o
 obj-$(CONFIG_REGULATOR_S5M8767) += s5m8767.o
