From 03c833bf6bd5b4cf9b00a9d537a7c40164c233c8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Wed, 30 Sep 2026 00:07:00 +0200
Subject: [PATCH v1 1/2] dt-bindings: display: panel: add Samsung S6E3FC3
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add a binding for the Samsung S6E3FC3 DDIC. The first documented panel is
the AMS646YD04 fitted to the Galaxy A52 (a52q): a 1080x2400 FHD+ command
mode AMOLED driven over MIPI DSI, with vddio and vci supplies and a reset
GPIO.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 .../display/panel/samsung,s6e3fc3.yaml        | 70 +++++++++++++++++++
 1 file changed, 70 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/samsung,s6e3fc3.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/samsung,s6e3fc3.yaml b/Documentation/devicetree/bindings/display/panel/samsung,s6e3fc3.yaml
new file mode 100644
index 000000000000..5583d3cf6cb5
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/samsung,s6e3fc3.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/samsung,s6e3fc3.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S6E3FC3 AMOLED DDIC
+
+maintainers:
+  - Miroslav Mráz <miroslav.mraz@techmania.cz>
+
+description:
+  The S6E3FC3 is a display driver IC that drives a command/video mode AMOLED
+  panel over MIPI DSI.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    items:
+      - enum:
+            # Samsung 6.5 inch, 1080x2400 FHD+ panel
+          - samsung,s6e3fc3-ams646yd04
+      - const: samsung,s6e3fc3
+
+  reg:
+    maxItems: 1
+
+  vci-supply:
+    description: VCI regulator
+
+  vddio-supply:
+    description: VDDIO regulator
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - vci-supply
+  - vddio-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "samsung,s6e3fc3-ams646yd04", "samsung,s6e3fc3";
+            reg = <0>;
+
+            vddio-supply = <&vreg_l13a_1p8>;
+            vci-supply = <&vreg_l18a_3p0>;
+
+            reset-gpios = <&tlmm 8 GPIO_ACTIVE_LOW>;
+
+            port {
+                panel_in: endpoint {
+                    remote-endpoint = <&mdss_dsi0_out>;
+                };
+            };
+        };
+    };
+...
-- 
