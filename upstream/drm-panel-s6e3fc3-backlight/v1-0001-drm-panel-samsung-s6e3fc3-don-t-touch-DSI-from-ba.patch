From 453f2d6df927b1262965a5c6c10437cb0a0a5130 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Sat, 3 Oct 2026 11:23:21 +0200
Subject: [PATCH v1] drm/panel: samsung-s6e3fc3: don't touch DSI from backlight
 ops while off
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The backlight update_status/get_brightness callbacks issue DCS traffic on
the panel's MIPI DSI link unconditionally. When the backlight sysfs device
exists but the panel is not enabled (e.g. during the simpledrm->msm
handover early at boot), systemd-backlight restores the saved brightness
by writing the sysfs 'brightness' attribute. update_status then tries a
DCS write on a link that is not up, which fails and is reported back to
userspace as

  systemd-backlight[...]: ae94000.dsi.0: Failed to write system
  'brightness' attribute: Invalid argument

(the restored value, 314, is well below max_brightness 1023, so this is
not a range error). Reading actual_brightness fails the same way.

Track the panel's enabled state and make both backlight ops a no-op while
the panel is off. The brightness value is still stored by the backlight
core and gets applied by drm_panel_enable()->backlight_enable() once the
panel comes up, so nothing is lost.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 drivers/gpu/drm/panel/panel-samsung-s6e3fc3.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3fc3.c b/drivers/gpu/drm/panel/panel-samsung-s6e3fc3.c
index 0b8f1625cbda..ea26d5c795ec 100644
--- a/drivers/gpu/drm/panel/panel-samsung-s6e3fc3.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3fc3.c
@@ -24,6 +24,8 @@ struct panel_info {
 
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data supplies[2];
+
+	bool enabled;
 };
 
 struct panel_desc {
@@ -203,6 +205,8 @@ static int s6e3fc3_enable(struct drm_panel *panel)
 	if (dsi_ctx.accum_err) {
 		gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
 		regulator_bulk_disable(ARRAY_SIZE(pinfo->supplies), pinfo->supplies);
+	} else {
+		pinfo->enabled = true;
 	}
 
 	return dsi_ctx.accum_err;
@@ -229,6 +233,8 @@ static int s6e3fc3_disable(struct drm_panel *panel)
 	struct panel_info *pinfo = to_panel_info(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
 
+	pinfo->enabled = false;
+
 	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
 	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 70);
@@ -289,9 +295,13 @@ static const struct drm_panel_funcs s6e3fc3_panel_funcs = {
 static int s6e3fc3_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
 
+	if (!pinfo->enabled)
+		return 0;
+
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
@@ -306,9 +316,13 @@ static int s6e3fc3_bl_update_status(struct backlight_device *bl)
 static int s6e3fc3_bl_get_brightness(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness;
 	int ret;
 
+	if (!pinfo->enabled)
+		return 0;
+
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
-- 
2.55.0

