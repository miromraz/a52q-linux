From 31da9bab0466bdf1c7db0303eeec3fe2fa436e85 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Wed, 30 Sep 2026 17:10:49 +0200
Subject: [PATCH v1 3/4] dt-bindings: usb: add Silicon Mitus SM5714 MUIC data
 switch
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The SM5714 MUIC block holds the analog switch for the USB D+/D- data
lines and is exposed on its own I2C address. Describe it as a Type-C
mode switch: it is driven through the connector graph by the SM5714
Type-C CC detection block to force the data lines onto the USB path
while the port operates as a host.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 .../usb/siliconmitus,sm5714-muic.yaml         | 62 +++++++++++++++++++
 MAINTAINERS                                   |  6 ++
 2 files changed, 68 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/usb/siliconmitus,sm5714-muic.yaml

diff --git a/Documentation/devicetree/bindings/usb/siliconmitus,sm5714-muic.yaml b/Documentation/devicetree/bindings/usb/siliconmitus,sm5714-muic.yaml
new file mode 100644
index 000000000000..6b87fc52fe7c
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/siliconmitus,sm5714-muic.yaml
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/siliconmitus,sm5714-muic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5714 MUIC USB data switch
+
+maintainers:
+  - Miroslav Mráz <miroslav.mraz@techmania.cz>
+
+description:
+  The SM5714 is a combo PMIC integrating a charger, a fuel gauge and a
+  Type-C/USB block. This binding describes the MUIC (Micro USB Interface
+  Controller) block, which is exposed on its own I2C address and contains the
+  analog switch for the USB D+/D- data lines. It is used as a Type-C mode
+  switch, driven by the Type-C CC detection block through the connector graph,
+  to force the data lines onto the USB path while operating as a host.
+
+properties:
+  compatible:
+    const: siliconmitus,sm5714-muic
+
+  reg:
+    maxItems: 1
+
+  mode-switch: true
+
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description:
+      A port node to link the MUIC to the SM5714 Type-C CC detection block,
+      which drives the USB data path switching.
+
+required:
+  - compatible
+  - reg
+  - mode-switch
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        typec-mux@25 {
+            compatible = "siliconmitus,sm5714-muic";
+            reg = <0x25>;
+
+            mode-switch;
+
+            port {
+                sm5714_muic_ept: endpoint {
+                    remote-endpoint = <&sm5714_cc_ept>;
+                };
+            };
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index 14ac4537b2b7..0156c8064a17 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -25081,6 +25081,12 @@ S:	Supported
 F:	Documentation/devicetree/bindings/net/wireless/silabs,wfx.yaml
 F:	drivers/net/wireless/silabs/
 
