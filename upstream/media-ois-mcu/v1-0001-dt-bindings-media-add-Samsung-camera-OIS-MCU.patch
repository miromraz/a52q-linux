From f4b39bf4a8c031f00b59388a6bbf6a060c04d3a3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Thu, 1 Oct 2026 00:47:26 +0200
Subject: [PATCH v1 1/2] dt-bindings: media: add Samsung camera OIS MCU
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Samsung camera optical image stabilisation (OIS) MCU is an STM32G
microcontroller running Samsung OIS firmware, controlled over I2C. It
stabilises a main camera module and is powered through runtime PM as a
supplier of the image sensor it serves. Add its binding.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 .../bindings/media/i2c/samsung,ois-mcu.yaml   | 88 +++++++++++++++++++
 MAINTAINERS                                   |  5 ++
 2 files changed, 93 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/samsung,ois-mcu.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/samsung,ois-mcu.yaml b/Documentation/devicetree/bindings/media/i2c/samsung,ois-mcu.yaml
new file mode 100644
index 000000000000..bb36be2aee32
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/samsung,ois-mcu.yaml
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/samsung,ois-mcu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung camera OIS MCU
+
+maintainers:
+  - Miroslav Mráz <miroslav.mraz@techmania.cz>
+
+description:
+  The Samsung camera optical image stabilisation (OIS) MCU is an STM32G
+  microcontroller running Samsung OIS firmware, controlled over I2C. It
+  stabilises a main camera module and has no image data path of its own.
+  It is powered through runtime PM as a supplier of the image sensor it
+  serves, so that streaming the sensor resumes and initialises the OIS.
+
+properties:
+  compatible:
+    const: samsung,ois-mcu
+
+  reg:
+    maxItems: 1
+
+  vdd-supply:
+    description: Motor drive supply.
+
+  vio-supply:
+    description: I/O and logic supply.
+
+  reset-gpios:
+    description: MCU NRST reset line, active low.
+    maxItems: 1
+
+  boot0-gpios:
+    description:
+      MCU BOOT0 line. Held low to boot from the main flash rather than the
+      ST system bootloader.
+    maxItems: 1
+
+  samsung,image-sensor:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the image sensor this MCU stabilises. The OIS is added as a
+      runtime-PM supplier of that sensor, so streaming the sensor powers and
+      initialises the OIS.
+
+  nvmem-cells:
+    items:
+      - description: OIS calibration valid mark from the module EEPROM.
+      - description: Wide XGG/YGG gyro gain calibration from the module EEPROM.
+
+  nvmem-cell-names:
+    items:
+      - const: cal-mark
+      - const: xygg
+
+required:
+  - compatible
+  - reg
+  - vdd-supply
+  - vio-supply
+  - reset-gpios
+  - boot0-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        ois@62 {
+            compatible = "samsung,ois-mcu";
+            reg = <0x62>;
+            vdd-supply = <&vreg_cam_l7>;
+            vio-supply = <&vreg_cam_l3>;
+            reset-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
+            boot0-gpios = <&tlmm 43 GPIO_ACTIVE_HIGH>;
+            samsung,image-sensor = <&main_sensor>;
+        };
+    };
+
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index 72294ddfa5b7..2dfba8a27c51 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -24356,6 +24356,11 @@ F:	drivers/rtc/rtc-s5m.c
 F:	include/dt-bindings/regulator/samsung,s2m*.h
 F:	include/linux/mfd/samsung/
 
