From 33d6ddf265d0d342be39c1deaf11c929555b9aae Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Thu, 1 Oct 2026 00:19:01 +0200
Subject: [PATCH v1 1/2] dt-bindings: media: add Samsung S5K3L6XX
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Samsung S5K3L6XX is a 1/3.1" 13MP CMOS image sensor controlled over
I2C and streaming RAW10 over a 4-lane MIPI CSI-2 D-PHY interface. It is
the ultra-wide camera of the Samsung Galaxy A52 4G (a52q, SM7125). Add a
device tree binding for it.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 .../bindings/media/i2c/samsung,s5k3l6xx.yaml  | 111 ++++++++++++++++++
 MAINTAINERS                                   |   6 +
 2 files changed, 117 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/samsung,s5k3l6xx.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/samsung,s5k3l6xx.yaml b/Documentation/devicetree/bindings/media/i2c/samsung,s5k3l6xx.yaml
new file mode 100644
index 000000000000..eb8de81e2b26
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/samsung,s5k3l6xx.yaml
@@ -0,0 +1,111 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/samsung,s5k3l6xx.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S5K3L6XX Image Sensor
+
+maintainers:
+  - Miroslav Mráz <miroslav.mraz@techmania.cz>
+
+description:
+  The Samsung S5K3L6XX is a 1/3.1-inch 13MP CMOS active pixel digital image
+  sensor with a Bayer colour filter array. It is programmable through an I2C
+  interface and outputs image data over a 4-lane MIPI CSI-2 D-PHY interface.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: samsung,s5k3l6xx
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK supply clock.
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: mclk
+
+  clock-frequency:
+    description: MCLK frequency in Hz.
+    minimum: 6000000
+    maximum: 32000000
+
+  rstn-gpios:
+    description: Active low GPIO connected to the RESETN pad of the sensor.
+    maxItems: 1
+
+  vdda-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  vddd-supply:
+    description: Digital core voltage supply, 1.05 volts.
+
+  vddio-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@2d {
+            compatible = "samsung,s5k3l6xx";
+            reg = <0x2d>;
+            clocks = <&camera_mclk 0>;
+            clock-names = "mclk";
+            clock-frequency = <19200000>;
+            rstn-gpios = <&tlmm 66 GPIO_ACTIVE_LOW>;
+            vdda-supply = <&vreg_2p8>;
+            vddd-supply = <&vreg_1p05>;
+            vddio-supply = <&vreg_1p8>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csiphy3_ep>;
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <595200000>;
+                };
+            };
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index 72294ddfa5b7..16adfb6acb6b 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -24376,6 +24376,12 @@ S:	Supported
 F:	Documentation/devicetree/bindings/media/samsung,s5c73m3.yaml
 F:	drivers/media/i2c/s5c73m3/*
 
+SAMSUNG S5K3L6XX CAMERA DRIVER
