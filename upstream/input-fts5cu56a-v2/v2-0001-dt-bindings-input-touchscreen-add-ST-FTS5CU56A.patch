From 72f32a675420c7d3f1fa4f135713da1988c99e77 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Tue, 29 Sep 2026 22:59:54 +0200
Subject: [PATCH v2 1/2] dt-bindings: input/touchscreen: add ST FTS5CU56A
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add a binding for the STMicroelectronics FTS5CU56A I2C touchscreen
controller found on the Samsung Galaxy A52 (a52q).

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 .../input/touchscreen/st,fts5cu56a.yaml       | 60 +++++++++++++++++++
 1 file changed, 60 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/touchscreen/st,fts5cu56a.yaml

diff --git a/Documentation/devicetree/bindings/input/touchscreen/st,fts5cu56a.yaml b/Documentation/devicetree/bindings/input/touchscreen/st,fts5cu56a.yaml
new file mode 100644
index 000000000000..6ad5950598b0
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/st,fts5cu56a.yaml
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/st,fts5cu56a.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: STMicroelectronics FTS5CU56A touchscreen controller
+
+maintainers:
+  - Miroslav Mráz <miroslav.mraz@techmania.cz>
+
+description:
+  The FTS5CU56A is an I2C capacitive multi-touch controller found on the
+  Samsung Galaxy A52 (a52q) and similar devices.
+
+allOf:
+  - $ref: touchscreen.yaml#
+
+properties:
+  compatible:
+    const: st,fts5cu56a
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  vdd-supply:
+    description: Digital power supply (1.8V).
+
+  avdd-supply:
+    description: Analog power supply (3.0V).
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - vdd-supply
+  - avdd-supply
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@49 {
+            compatible = "st,fts5cu56a";
+            reg = <0x49>;
+            interrupt-parent = <&tlmm>;
+            interrupts = <9 IRQ_TYPE_LEVEL_LOW>;
+            vdd-supply = <&vreg_l10a_1p8>;
+            avdd-supply = <&vreg_l7c_3p0>;
+        };
+    };
+...
-- 
