From abbfcc218f4c4c38d5ec8e8edb86da03ee47db5f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Tue, 29 Sep 2026 22:59:56 +0200
Subject: [PATCH v1 3/5] dt-bindings: power: supply: add Silicon Mitus SM5714
 charger
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Describe the charger block of the SM5714 combo PMIC, exposed on its own
I2C address, including its charging current properties and the USB OTG
VBUS boost regulator.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 .../supply/siliconmitus,sm5714-charger.yaml   | 80 +++++++++++++++++++
 1 file changed, 80 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/siliconmitus,sm5714-charger.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5714-charger.yaml b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5714-charger.yaml
new file mode 100644
index 000000000000..6f4a11c27d65
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5714-charger.yaml
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/siliconmitus,sm5714-charger.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5714 charger
+
+maintainers:
+  - Miroslav Mráz <miroslav.mraz@techmania.cz>
+
+description:
+  The SM5714 is a combo PMIC integrating a charger, a fuel gauge and a
+  Type-C/USB block. This binding describes the charger block, which is
+  exposed on its own I2C address. It controls battery charging, provides
+  the USB OTG VBUS boost regulator and a torch LED output.
+
+properties:
+  compatible:
+    const: siliconmitus,sm5714-charger
+
+  reg:
+    maxItems: 1
+
+  siliconmitus,enable-autostop:
+    type: boolean
+    description:
+      Stop charging automatically once the top-off condition is reached.
+
+  siliconmitus,input-current-limit:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Input (VBUS) current limit in mA.
+    minimum: 100
+    maximum: 3000
+
+  siliconmitus,charging-current:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Fast-charging current in mA.
+    minimum: 100
+    maximum: 3500
+
+  siliconmitus,topoff-current:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Top-off (charge termination) current in mA.
+    minimum: 100
+    maximum: 675
+
+  usb-otg-vbus:
+    type: object
+    $ref: /schemas/regulator/regulator.yaml#
+    description: USB OTG VBUS boost regulator provided by the charger.
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        charger@49 {
+            compatible = "siliconmitus,sm5714-charger";
+            reg = <0x49>;
+
+            siliconmitus,enable-autostop;
+            siliconmitus,input-current-limit = <1300>;
+            siliconmitus,charging-current = <1300>;
+            siliconmitus,topoff-current = <225>;
+
+            usb-otg-vbus {
+                regulator-name = "usb_otg_vbus";
+            };
+        };
+    };
+...
-- 
