From e7f1cdb38e54c451f0d3e9f218550b1c84faf9c9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miroslav=20Mr=C3=A1z?= <miroslav.mraz@techmania.cz>
Date: Tue, 29 Sep 2026 22:24:12 +0200
Subject: [PATCH 1/4] dt-bindings: power: supply: add Silicon Mitus SM5714 fuel
 gauge
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The SM5714 is a combo PMIC integrating a charger, a fuel gauge and a
Type-C/USB block, each on its own I2C address. Add a binding for the fuel
gauge block, which reports battery voltage, current, temperature and state
of charge.

No public datasheet is available; the register layout is taken from the
Samsung downstream driver.

Signed-off-by: Miroslav Mráz <miroslav.mraz@techmania.cz>
---
 .../power/supply/siliconmitus,sm5714-fg.yaml  | 42 +++++++++++++++++++
 1 file changed, 42 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/siliconmitus,sm5714-fg.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5714-fg.yaml b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5714-fg.yaml
new file mode 100644
index 000000000000..f7cef7031209
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5714-fg.yaml
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/siliconmitus,sm5714-fg.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5714 fuel gauge
+
+maintainers:
+  - Miroslav Mráz <miroslav.mraz@techmania.cz>
+
+description:
+  The SM5714 is a combo PMIC integrating a charger, a fuel gauge and a
+  Type-C/USB block. This binding describes the fuel gauge block, which is
+  exposed on its own I2C address and reports battery voltage, current,
+  temperature and state of charge.
+
+properties:
+  compatible:
+    const: siliconmitus,sm5714-fg
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        fuel-gauge@71 {
+            compatible = "siliconmitus,sm5714-fg";
+            reg = <0x71>;
+        };
+    };
+...
-- 
