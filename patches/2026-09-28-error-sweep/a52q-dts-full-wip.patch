@@ -110,10 +110,49 @@ vreg_cam4_vana: regulator-cam4-vana {
 		enable-active-high;
 	};
 
+	/*
+	 * MIPI switch on gpio66: UW (S5K3L6) and macro (GC5035) share CSIPHY3.
+	 * Active-high, so mux state 0 drives gpio66 low (UW) and state 1 high
+	 * (macro), matching the board wiring.
+	 */
+	cam_mipi_mux: mux-controller {
+		compatible = "gpio-mux";
+		#mux-control-cells = <0>;
+		mux-gpios = <&tlmm 66 GPIO_ACTIVE_HIGH>;
+	};
+
+	video-mux {
+		compatible = "video-mux";
+		mux-controls = <&cam_mipi_mux>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;	/* mux state 0: UW */
+			vmux_in_uw: endpoint {
+				remote-endpoint = <&cam_s5k3l6_ep>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;	/* mux state 1: macro */
+			vmux_in_macro: endpoint {
+				remote-endpoint = <&cam_gc5035_macro_ep>;
+			};
+		};
+
+		port@2 {
+			reg = <2>;	/* output to CSIPHY3 */
+			vmux_out: endpoint {
+				remote-endpoint = <&csiphy3_ep>;
+			};
+		};
+	};
+
 	/* AP sleep state for the ADSP sensor framework, see smp2p_sleepstate.c */
 	smp2p-sleepstate {
 		compatible = "qcom,smp2p-sleepstate";
-		qcom,smem-states = <&sleepstate_smp2p_out 0>;
+		qcom,smem-states = <&sleepstate_smp2p_out 12>;
 		interrupts-extended = <&sleepstate_smp2p_in 0 IRQ_TYPE_EDGE_RISING>;
 	};
 
