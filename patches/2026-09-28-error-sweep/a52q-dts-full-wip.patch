+/*
+ * Main camera VCM: AK7374 on QUP i2c9 (gpio46/47), downstream actuator_rear0
+ * (slave 0x18 8-bit). The module EEPROM (M24128, 16 KiB, AF/AWB/LSC cal) sits
+ * on the same bus at 0x50, the front module EEPROM at 0x51.
+ */
+&i2c9 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	cam_main_vcm: camera-lens@c {
+		compatible = "asahi-kasei,ak7374";
+		reg = <0x0c>;
+		vdd-supply = <&vreg_cam_l7>;
+		vio-supply = <&vreg_cam_l3>;
+	};
+
+	/* Main module OTP (M24128), same rails as the main sensor/VCM. */
+	cam_main_eeprom: eeprom@50 {
+		compatible = "atmel,24c64";
+		reg = <0x50>;
+		pagesize = <32>;
+		read-only;
+		vcc-supply = <&vreg_cam_l3>;
+	};
+
+	/*
+	 * Front module OTP (ON Semi N24S64B). Powered by the sensor vio rail,
+	 * so it only answers while the front sensor is powered.
+	 */
+	eeprom@51 {
+		compatible = "atmel,24c64";
+		reg = <0x51>;
+		pagesize = <32>;
+		read-only;
+		vcc-supply = <&vreg_cam_l3>;
+	};
+};
+
 /* UW: Samsung S5K3L6, 4-lane, CSIPHY3. MCLK 19.2 MHz to match the vendor init PLL. */
