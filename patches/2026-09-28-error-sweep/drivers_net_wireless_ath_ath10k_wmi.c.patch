diff --git a/drivers/net/wireless/ath/ath10k/wmi.c b/drivers/net/wireless/ath/ath10k/wmi.c
index 5e061f752..ac2c7cd12 100644
--- a/drivers/net/wireless/ath/ath10k/wmi.c
+++ b/drivers/net/wireless/ath/ath10k/wmi.c
@@ -2729,8 +2729,18 @@ static void ath10k_wmi_event_chan_info_unpaired(struct ath10k *ar,
 
 	idx = freq_to_idx(ar, params->freq);
 	if (idx >= ARRAY_SIZE(ar->survey)) {
-		ath10k_warn(ar, "chan info: invalid frequency %d (idx %d out of bounds)\n",
-			    params->freq, idx);
+		/*
+		 * WCN3990 firmware emits a spurious chan_info event with
+		 * freq 0 on every scan; it maps to no survey channel and is
+		 * harmless. Log only that case at debug level to avoid log spam (see commit
+		 * 8a952a955de7 for the sibling warning).
+		 */
+		if (params->freq)
+			ath10k_warn(ar, "chan info: invalid frequency %d (idx %d out of bounds)\n",
+				    params->freq, idx);
+		else
+			ath10k_dbg(ar, ATH10K_DBG_WMI, "chan info: invalid frequency %d (idx %d out of bounds)\n",
+				   params->freq, idx);
 		return;
 	}
 
