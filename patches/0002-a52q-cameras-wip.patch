+	//.enum_frame_interval	= s5k3l6xx_enum_frame_interval,
+	.get_frame_interval     = s5k3l6xx_g_frame_interval,
+	.set_frame_interval     = s5k3l6xx_s_frame_interval,
+	.get_fmt		= s5k3l6xx_get_fmt,
