diff --git a/sound/soc/qcom/qdsp6/q6asm.c b/sound/soc/qcom/qdsp6/q6asm.c
index 06a802f9d..eee1c5366 100644
--- a/sound/soc/qcom/qdsp6/q6asm.c
+++ b/sound/soc/qcom/qdsp6/q6asm.c
@@ -654,6 +654,19 @@ static int32_t q6asm_stream_callback(struct apr_device *adev,
 				goto done;
 			}
 			break;
+		case ASM_DATA_CMD_WRITE_V2:
+		case ASM_DATA_CMD_READ_V2:
+		case ASM_DATA_CMD_EOS:
+			/*
+			 * Some DSP firmwares (e.g. Galaxy A52 / sm7125) emit a
+			 * redundant APR basic-response ack for these async data
+			 * commands. Completion is already tracked via the
+			 * dedicated WRITE_DONE / READ_DONE / RENDERED_EOS events,
+			 * so drop these acks silently instead of logging an error
+			 * for every buffer.
+			 */
+			ret = 0;
+			goto done;
 		default:
 			dev_err(ac->dev, "command[0x%x] not expecting rsp\n",
 				result->opcode);
