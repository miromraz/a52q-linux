diff --git a/hexagonrpcd/hexagonfs_mapped.c b/hexagonrpcd/hexagonfs_mapped.c
index 28c5a7a..d64d6c5 100644
--- a/hexagonrpcd/hexagonfs_mapped.c
+++ b/hexagonrpcd/hexagonfs_mapped.c
@@ -84,6 +84,52 @@ err:
 	return ret;
 }
 
+/*
+ * a52q: duplicate an already-open (real- or empty-backed) handle so a path that
+ * resolves to it yields an independently-closeable fd. ->up is the original
+ * (assigned) fd, which keeps close() safe; ".." from a clone therefore returns
+ * to the same dir rather than its parent, which the sensor PD never relies on.
+ */
+static int mapped_clone(struct hexagonfs_fd *fd, struct hexagonfs_fd **out)
+{
+	struct mapped_ctx *src = fd->data;
+	struct mapped_ctx *ctx = NULL;
+	struct hexagonfs_fd *nfd;
+
+	nfd = malloc(sizeof(*nfd));
+	if (nfd == NULL)
+		return -ENOMEM;
+
+	if (src != NULL) {
+		int nf;
+
+		ctx = malloc(sizeof(*ctx));
+		if (ctx == NULL) {
+			free(nfd);
+			return -ENOMEM;
+		}
+
+		nf = dup(src->fd);
+		if (nf == -1) {
+			free(ctx);
+			free(nfd);
+			return -errno;
+		}
+
+		ctx->fd = nf;
+		ctx->dir = NULL;
+	}
+
+	nfd->is_assigned = false;
+	nfd->up = fd;
+	nfd->ops = fd->ops;
+	nfd->data = ctx;
+
+	*out = nfd;
+
+	return 0;
+}
+
 static int mapped_openat(struct hexagonfs_fd *dir,
 			 const char *segment,
 			 bool expect_dir,
@@ -370,6 +416,7 @@ struct hexagonfs_file_ops hexagonfs_mapped_ops = {
 	.readdir = mapped_readdir,
 	.seek = mapped_seek,
 	.stat = mapped_stat,
+	.clone = mapped_clone,
 };
 
 struct hexagonfs_file_ops hexagonfs_mapped_or_empty_ops = {
@@ -380,6 +427,7 @@ struct hexagonfs_file_ops hexagonfs_mapped_or_empty_ops = {
 	.readdir = mapped_or_empty_readdir,
 	.seek = mapped_or_empty_seek,
 	.stat = mapped_or_empty_stat,
+	.clone = mapped_clone,
 };
 
 struct hexagonfs_file_ops hexagonfs_mapped_sysfs_ops = {
@@ -390,4 +438,5 @@ struct hexagonfs_file_ops hexagonfs_mapped_sysfs_ops = {
 	.readdir = mapped_readdir,
 	.seek = mapped_seek,
 	.stat = mapped_sysfs_stat,
+	.clone = mapped_clone,
 };
