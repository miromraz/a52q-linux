diff --git a/hexagonrpcd/hexagonfs.c b/hexagonrpcd/hexagonfs.c
index 94463ea..34c86e2 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -181,6 +181,29 @@ int hexagonfs_openat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const cha
 	if (ret)
 		goto err;
 
+	/*
+	 * a52q: if the path resolved to an already-open handle (an assigned fd,
+	 * e.g. "/" or a pure "." / ".." walk) we must hand back an independent
+	 * copy. Returning the shared object would let a later close() free an fd
+	 * still referenced elsewhere (use-after-free -> SIGSEGV). destroy_file_
+	 * descriptor() leaves assigned fds untouched, so a failure here cannot
+	 * free the original.
+	 */
+	if (fd->is_assigned) {
+		struct hexagonfs_fd *dup;
+
+		if (fd->ops->clone == NULL) {
+			ret = -ENOTSUP;
+			goto err;
+		}
+
+		ret = fd->ops->clone(fd, &dup);
+		if (ret)
+			goto err;
+
+		fd = dup;
+	}
+
 	ret = allocate_file_number(fds, fd);
 	if (ret)
 		goto err;
diff --git a/hexagonrpcd/hexagonfs.h b/hexagonrpcd/hexagonfs.h
index 5d0859b..df35c66 100644
--- a/hexagonrpcd/hexagonfs.h
+++ b/hexagonrpcd/hexagonfs.h
@@ -44,6 +44,13 @@ struct hexagonfs_file_ops {
 	int (*mkdir)(struct hexagonfs_fd *dir, const char *segment, mode_t mode);
 	int (*stat)(struct hexagonfs_fd *fd, struct stat *stats);
 	int (*seek)(struct hexagonfs_fd *fd, off_t off, int whence);
+	/*
+	 * a52q: produce an independently-owned copy of an already-open dir fd.
+	 * Needed when a path resolves to an existing open handle (e.g. opendir
+	 * of the root / an empty registry base) so closing the new handle does
+	 * not free the shared original. Only directories implement this.
+	 */
+	int (*clone)(struct hexagonfs_fd *fd, struct hexagonfs_fd **out);
 };
 
