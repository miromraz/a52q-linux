libcamera: add IMX616 sensor helper and properties

Sony gain model gain = 1024 / (1024 - code) (from the vendor sensor library),
black level 64 @ 10 bit (measured), 0.8 um cells, test pattern menu of the
kernel driver. Applies to libcamera 0.7.2 with patch -p1.

diff -ruN a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
--- a/src/ipa/libipa/camera_sensor_helper.cpp	2026-09-27 11:14:19.061609146 +0200
+++ b/src/ipa/libipa/camera_sensor_helper.cpp	2026-09-27 11:14:19.148276139 +0200
@@ -642,6 +642,19 @@
 };
 REGISTER_CAMERA_SENSOR_HELPER("imx477", CameraSensorHelperImx477)
 
+class CameraSensorHelperImx616 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx616()
+	{
+		/* Measured on the Galaxy A52 (a52q) front camera: 64 at 10 bits. */
+		blackLevel_ = 4096;
+		/* Vendor sensor library: gain = 1024 / (1024 - code). */
+		gain_ = AnalogueGainLinear{ 0, 1024, -1, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx616", CameraSensorHelperImx616)
+
 class CameraSensorHelperImx678 : public CameraSensorHelper
 {
 public:
