+	{
+		/* Vendor sensor module: black level 64 at 10 bits. */
+		blackLevel_ = 4096;
+		/*
+		 * Vendor CamX sensor library: analogue gain code = gain * 32
+		 * (0x20 = 1x .. 0x400 = 32x), verified linear on the device.
+		 */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
