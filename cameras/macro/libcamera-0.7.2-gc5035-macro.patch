From: Claude (macro camera agent) <noreply@anthropic.com>
Subject: [PATCH] libipa, sensor: add gc5035_macro (A52 5G macro GC5035 module)

The macro GC5035 is named "gc5035_macro" by its DT label so it gets its
own tuning file. Give it the gc5035 sensor helper and static properties.
Applies on top of cameras/depth/libcamera-0.7.2-gc5035.patch.
---
diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index af8d7ba..00e9b6c 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -533,6 +533,12 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("gc5035", CameraSensorHelperGc5035)
 
+/* Macro GC5035 module, named "gc5035_macro" through its DT label. */
+class CameraSensorHelperGc5035Macro : public CameraSensorHelperGc5035
+{
+};
+REGISTER_CAMERA_SENSOR_HELPER("gc5035_macro", CameraSensorHelperGc5035Macro)
+
 class CameraSensorHelperHm1246 : public CameraSensorHelper
 {
 public:
diff --git a/src/libcamera/sensor/camera_sensor_properties.cpp b/src/libcamera/sensor/camera_sensor_properties.cpp
index d7f2c9d..5071da0 100644
--- a/src/libcamera/sensor/camera_sensor_properties.cpp
+++ b/src/libcamera/sensor/camera_sensor_properties.cpp
@@ -145,6 +145,19 @@ const CameraSensorProperties *CameraSensorProperties::get(const std::string &sen
 				.hblankDelay = 2
 			},
 		} },
+		{ "gc5035_macro", {
+			.unitCellSize = { 1120, 1120 },
+			.testPatternModes = {
+				{ controls::draft::TestPatternModeOff, 0 },
+				{ controls::draft::TestPatternModeColorBars, 1 },
+			},
+			.sensorDelays = {
+				.exposureDelay = 2,
+				.gainDelay = 2,
+				.vblankDelay = 2,
+				.hblankDelay = 2
+			},
+		} },
 		{ "hi846", {
 			.unitCellSize = { 1120, 1120 },
 			.testPatternModes = {
