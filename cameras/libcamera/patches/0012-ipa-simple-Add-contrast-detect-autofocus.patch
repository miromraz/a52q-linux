--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,402 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2025 Vasiliy Doylov <nekodevelopper@gmail.com>
+ *
+ * Auto focus
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/base/log.h>
+#include "libcamera/base/utils.h"
+
+#include "control_ids.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAutoFocus)
+
+namespace ipa::soft::algorithms {
+
+Af::Af()
+{
+}
+
+/*
+ * Tuning data:
+ *   lensRange: [ min, max ]    optional: VCM codes LensPosition 0 and 100
+ *                              map to, e.g. the module's calibrated
+ *                              infinity and macro positions. Defaults to
+ *                              the range of V4L2_CID_FOCUS_ABSOLUTE.
+ *
+ * Without a lens the algorithm does nothing.
+ */
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	auto range = tuningData["lensRange"].get<std::vector<int32_t>>();
+	if (range) {
+		if (range->size() != 2 || (*range)[0] >= (*range)[1]) {
+			LOG(IPASoftAutoFocus, Error) << "Invalid 'lensRange'";
+			return -EINVAL;
+		}
+		lensRange_ = { (*range)[0], (*range)[1] };
+	}
+
+	context.ctrlMap[&controls::LensPosition] = ControlInfo(0.0f, 100.0f, 50.0f);
+	/*
+	 * Advertise the standard AF control surface. Default to continuous
+	 * focus: that is what a phone camera application expects, and it makes
+	 * the camera usable without the app having to issue an AfTrigger.
+	 */
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues,
+			    ControlValue(controls::AfModeContinuous));
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(controls::AfTriggerValues,
+			    ControlValue(controls::AfTriggerStart));
+	return 0;
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	auto &focus = context.configuration.focus;
+	if (lensRange_ && focus.focus_max > focus.focus_min) {
+		focus.focus_min = std::clamp(lensRange_->first, focus.focus_min, focus.focus_max);
+		focus.focus_max = std::clamp(lensRange_->second, focus.focus_min, focus.focus_max);
+		LOG(IPASoftAutoFocus, Info) << "Lens range " << focus.focus_min
+					    << "-" << focus.focus_max;
+	}
+
+	context.activeState.knobs.focus_sweep = false;
+	context.activeState.knobs.focus_pos = 0;
+	context.activeState.knobs.af_mode = controls::AfModeContinuous;
+	context.configuration.focus.skip = 10;
+	context.configuration.focus.af_state = controls::AfStateIdle;
+	context.configuration.focus.have_focus = false;
+	context.configuration.focus.seeded = false;
+	return 0;
+}
+
+void Af::queueRequest([[maybe_unused]] typename Module::Context &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] typename Module::FrameContext &frameContext,
+		      const ControlList &controls)
+{
+	const auto &af_mode = controls.get(controls::AfMode);
+	if (af_mode.has_value()) {
+		context.activeState.knobs.af_mode = af_mode.value();
+		LOG(IPASoftAutoFocus, Debug) << "Setting AF mode to " << af_mode.value();
+	}
+
+	const auto &focus_pos = controls.get(controls::LensPosition);
+	if (focus_pos.has_value()) {
+		context.activeState.knobs.focus_pos = focus_pos;
+		context.configuration.focus.skip = 10;
+		LOG(IPASoftAutoFocus, Debug) << "Setting focus position to " << focus_pos.value();
+	}
+
+	const auto &af_trigger = controls.get(controls::AfTrigger);
+	if (af_trigger.has_value()) {
+		const int32_t mode = context.activeState.knobs.af_mode.value_or(controls::AfModeContinuous);
+		if (af_trigger.value() == controls::AfTriggerStart) {
+			/* AfTrigger is ignored in manual mode. */
+			if (mode == controls::AfModeAuto || mode == controls::AfModeContinuous)
+				restart(context);
+		} else if (af_trigger.value() == controls::AfTriggerCancel) {
+			/* Abort the scan and leave the lens where it is. */
+			context.activeState.knobs.focus_sweep = false;
+			context.configuration.focus.af_state = controls::AfStateIdle;
+			LOG(IPASoftAutoFocus, Info) << "AF scan cancelled";
+		}
+	}
+}
+
+void Af::updateFocus([[maybe_unused]] IPAContext &context, [[maybe_unused]] IPAFrameContext &frameContext, [[maybe_unused]] double exposureMSV)
+{
+	const auto &focus = context.configuration.focus;
+	frameContext.lens.focus_pos = focus.focus_min +
+		std::lround(context.activeState.knobs.focus_pos.value_or(50.0) / 100.0 *
+			    (focus.focus_max - focus.focus_min));
+}
+
+static int steps;
+
+/*
+ * Half-width of the seeded coarse window, in focus_pos units (0..100). A warm
+ * refocus scans only [last-WINDOW .. last+WINDOW] instead of the full range,
+ * expanding outward one window at a time if the peak lands on a (non-limit)
+ * window edge. ~10 units ~= 410 DAC codes on the LC898219XI; a knob because the
+ * "most refocuses are small" assumption is a property of the scene, not code.
+ */
+static constexpr double kSeedWindow = 10.0;
+
+/*
+ * Frames to discard after a seeded lens jump. The sharpness stat runs ~4 frames
+ * behind the lens (measured: identical values repeat 4x during a steady step),
+ * so a jump's first settled sample otherwise carries a stale reading from the
+ * pre-jump position and can win the peak search. Only the seeded path pays this;
+ * the cold sweep's cadence is unchanged.
+ */
+static constexpr uint32_t kSeedSettle = 5;
+
+void Af::restart(IPAContext &context)
+{
+	auto &f = context.configuration.focus;
+	steps = 0;
+	f.focus_max_pos = 0;
+	f.sharpness_max = 0;
+	f.sharpness_min = UINT64_MAX;
+	f.step = 2;
+	f.sample_step = 2;
+	f.best_lo_val = 0;
+	f.best_hi_val = 0;
+	f.want_hi = false;
+	f.prev_val = 0;
+	f.af_state = controls::AfStateScanning;
+
+	if (f.have_focus) {
+		/*
+		 * P8: warm refocus. Seed the search at the last converged
+		 * position and scan a small window around it. The full-range
+		 * park-to-0 slew and most of the coarse pass are skipped; the
+		 * fine pass that follows is identical to the cold path, so the
+		 * converged peak and its sharpness are unchanged. A bounded
+		 * move settles well within a couple of frames.
+		 */
+		f.seeded = true;
+		f.start = std::clamp(f.converged_pos - kSeedWindow, 0.0, 100.0);
+		f.stop = std::clamp(f.converged_pos + kSeedWindow, 0.0, 100.0);
+		f.skip = kSeedSettle;
+	} else {
+		/* Cold start: no history, park and sweep the full range. */
+		f.seeded = false;
+		f.start = 0;
+		f.stop = 100;
+		f.skip = 10;
+	}
+	f.prev_pos = f.start;
+	context.activeState.knobs.focus_pos = f.start;
+	context.activeState.knobs.focus_sweep = true;
+	LOG(IPASoftAutoFocus, Info) << "Starting focus sweep (seeded="
+		<< f.seeded << " " << f.start << ".." << f.stop << ")";
+}
+
+/*
+ * Anti-hunting monitor (P2). While locked, keep a rolling baseline of the scene
+ * metric so slow lighting drift is tracked rather than chased. Re-scan only when
+ * the metric deviates from that baseline by more than trigger_threshold for
+ * sensitivity consecutive frames -- the hysteresis is what stops per-frame
+ * sensor noise from throwing the lens into a full rescan (the old code
+ * re-triggered on a single 30 % wobble).
+ */
+void Af::monitor(IPAContext &context, uint64_t sharp)
+{
+	auto &f = context.configuration.focus;
+	constexpr uint64_t trigger_threshold = 40; /* percent from baseline */
+	constexpr int sensitivity = 10;		    /* consecutive frames */
+
+	f.monitor = (f.monitor * 15 + sharp) / 16;
+	uint64_t dev = utils::abs_diff(sharp, f.monitor);
+	if (f.monitor && dev > f.monitor * trigger_threshold / 100)
+		f.lost++;
+	else
+		f.lost = 0;
+	if (f.lost >= sensitivity) {
+		LOG(IPASoftAutoFocus, Info) << "Scene change -> re-scan (dev "
+			<< dev << " base " << f.monitor << ")";
+		restart(context);
+	}
+}
+
+void Af::step(IPAContext &context, double &focus_pos, uint64_t sharp, bool &sweep, bool continuous)
+{
+	auto &f = context.configuration.focus;
+	steps++;
+
+	/*
+	 * Per-step settle (P5): discard frames captured during/just after a lens
+	 * move so sharpness is measured at rest, not mid-slew. The VCM is
+	 * closed-loop and settles in under one frame (measured), so a small skip
+	 * is enough.
+	 */
+	if (f.skip != 0) {
+		f.skip--;
+		return;
+	}
+
+	if (!sweep) {
+		/* Re-scan only makes sense in continuous mode. */
+		if (continuous)
+			monitor(context, sharp);
+		return;
+	}
+
+	/*
+	 * Settled measurement at the current position. Track the best sample and
+	 * its immediate neighbours (for the P4 parabolic peak) and the plateau
+	 * floor (for the P7 confidence test).
+	 */
+	if (sharp > f.sharpness_max) {
+		f.best_lo_val = f.prev_val;
+		f.best_lo_pos = f.prev_pos;
+		f.sharpness_max = sharp;
+		f.focus_max_pos = focus_pos;
+		f.want_hi = true;
+	} else if (f.want_hi) {
+		f.best_hi_val = sharp;
+		f.best_hi_pos = focus_pos;
+		f.want_hi = false;
+	}
+	if (sharp < f.sharpness_min)
+		f.sharpness_min = sharp;
+	f.prev_val = sharp;
+	f.prev_pos = focus_pos;
+
+	focus_pos += f.step;
+	if (focus_pos > f.start && focus_pos < f.stop)
+		return;
+
+	/*
+	 * P8: seeded coarse pass finished. If the best sits on a window edge
+	 * that is not a hard focus limit, the true peak may lie beyond it:
+	 * shift the window that way and keep scanning coarse (carry the running
+	 * best). Only when the peak is bracketed inside the window -- or pinned
+	 * to a 0/100 hard stop -- do we fall through to the fine refine.
+	 */
+	if (f.seeded && f.step >= 1.0) {
+		double eps = f.step;
+		if (f.focus_max_pos >= f.stop - eps && f.stop < 100.0) {
+			f.start = f.stop;
+			f.stop = std::clamp(f.stop + 2.0 * kSeedWindow, 0.0, 100.0);
+			focus_pos = f.start;
+			f.skip = kSeedSettle;
+			return;
+		}
+		if (f.focus_max_pos <= f.start + eps && f.start > 0.0) {
+			f.stop = f.start;
+			f.start = std::clamp(f.start - 2.0 * kSeedWindow, 0.0, 100.0);
+			focus_pos = f.start;
+			f.skip = kSeedSettle;
+			return;
+		}
+	}
+
+	/* End of this pass: bracket the best and refine, or finish. */
+	int spread = 5;
+	f.start = std::clamp(f.focus_max_pos - f.step * spread, 0.0, 100.0);
+	f.stop = std::clamp(f.focus_max_pos + f.step * spread, 0.0, 100.0);
+	LOG(IPASoftAutoFocus, Info) << "Best focus on step " << f.step << " ("
+		<< f.start << ".." << f.stop << "): " << f.focus_max_pos
+		<< " value " << f.sharpness_max;
+	focus_pos = f.start;
+	f.sample_step = f.step;	/* spacing of the samples just taken */
+	f.step /= 4;		/* P4: coarse 2 -> fine 0.5 -> stop */
+	/* Settle after the jump back to the pass start. The seeded jump-back can
+	 * come from the top of range with a stale-high reading, so flush harder. */
+	f.skip = f.seeded ? kSeedSettle : 2;
+	if (f.step > 0.2) {
+		/* Run a real fine pass around the coarse peak; keep the plateau
+		 * floor, reset the peak tracker. */
+		f.sharpness_max = 0;
+		f.best_lo_val = 0;
+		f.best_hi_val = 0;
+		f.want_hi = false;
+		f.prev_val = 0;
+		return;
+	}
+
+	/*
+	 * Done. Parabolic interpolation through the best three fine samples (P4)
+	 * gives a sub-step peak; fall back to the best sample if they don't
+	 * bracket a maximum.
+	 */
+	double peak = f.focus_max_pos;
+	if (f.best_lo_val && f.best_hi_val) {
+		double a = f.best_lo_val, b = f.sharpness_max, c = f.best_hi_val;
+		double denom = a - 2.0 * b + c;
+		if (denom != 0.0) {
+			double off = 0.5 * (a - c) / denom;
+			if (off > -1.0 && off < 1.0)
+				peak = f.focus_max_pos + off * f.sample_step;
+		}
+	}
+	peak = std::clamp(peak, 0.0, 100.0);
+	f.focus_max_pos = peak;
+	focus_pos = peak;
+	sweep = false;
+
+	/* Remember this peak so the next refocus can seed from it (P8). */
+	f.converged_pos = peak;
+	f.have_focus = true;
+	f.seeded = false;
+
+	/* Seed the anti-hunting monitor baseline (P2). */
+	f.monitor = f.sharpness_max;
+	f.lost = 0;
+
+	LOG(IPASoftAutoFocus, Info) << "Sweep end. Best focus: " << peak
+		<< " steps " << steps << " peak " << f.sharpness_max
+		<< " floor " << f.sharpness_min;
+}
+
+void Af::process([[maybe_unused]] IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 [[maybe_unused]] const SwIspStats *stats,
+		 [[maybe_unused]] ControlList &metadata)
+{
+	/* No lens (focus_min == focus_max == 0): nothing to drive. */
+	if (context.configuration.focus.focus_max <= context.configuration.focus.focus_min)
+		return;
+
+	const int32_t mode = context.activeState.knobs.af_mode.value_or(controls::AfModeContinuous);
+
+	if (mode == controls::AfModeManual) {
+		/* Do not move the lens; honour LensPosition directly. */
+		context.activeState.knobs.focus_sweep = false;
+		context.configuration.focus.af_state = controls::AfStateIdle;
+	} else {
+		bool &sweep = context.activeState.knobs.focus_sweep.value();
+		const bool wasSweeping = sweep;
+		step(context,
+		     context.activeState.knobs.focus_pos.value(),
+		     stats->sharpness,
+		     sweep,
+		     mode == controls::AfModeContinuous);
+		if (sweep)
+			context.configuration.focus.af_state = controls::AfStateScanning;
+		else if (wasSweeping) {
+			/*
+			 * P7: report Focused only on a real peak, i.e. the best
+			 * sharpness stands clearly above the sweep's defocus
+			 * floor. A flat/low-contrast scene (peak ~= floor) is a
+			 * Failed lock, not a false Focused on mere sensor noise.
+			 */
+			const auto &f = context.configuration.focus;
+			bool focused = f.sharpness_min &&
+				       f.sharpness_min != UINT64_MAX &&
+				       f.sharpness_max > f.sharpness_min * 3 / 2;
+			context.configuration.focus.af_state =
+				focused ? controls::AfStateFocused
+					: controls::AfStateFailed;
+		}
+	}
+
+	updateFocus(context, frameContext, 0);
+
+	metadata.set(controls::AfState, context.configuration.focus.af_state);
+	metadata.set(controls::LensPosition,
+		     static_cast<float>(context.activeState.knobs.focus_pos.value()));
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
