diff --git a/src/ipa/simple/algorithms/lsc.cpp b/src/ipa/simple/algorithms/lsc.cpp
new file mode 100644
index 0000000..f216a17
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.cpp
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Lens shading correction for the software ISP
+ */
+
+#include "lsc.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftLsc)
+
+/**
+ * \class Lsc
+ * \brief Static lens shading correction mesh
+ *
+ * Tuning data:
+ *   grid: [ columns, rows ]    mesh size, nodes span the whole sensor frame
+ *   r, g, b: [ ... ]           columns * rows gains each, row-major, in the
+ *                              orientation of the raw frame
+ *   fadeGain: [ start, end ]   optional: fade the correction out between
+ *                              these analogue gains (less corner noise in
+ *                              low light, like the vendor tuning does)
+ */
+int Lsc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	auto grid = tuningData["grid"].get<std::vector<uint32_t>>();
+	if (!grid || grid->size() != 2 || (*grid)[0] < 2 || (*grid)[1] < 2 ||
+	    (*grid)[0] * (*grid)[1] > DebayerParams::kLscMaxNodes) {
+		LOG(IPASoftLsc, Error) << "Invalid 'grid'";
+		return -EINVAL;
+	}
+	width_ = (*grid)[0];
+	height_ = (*grid)[1];
+
+	const char *names[] = { "r", "g", "b" };
+	std::vector<std::vector<double>> tables;
+	for (const char *name : names) {
+		auto t = tuningData[name].get<std::vector<double>>();
+		if (!t || t->size() != width_ * height_) {
+			LOG(IPASoftLsc, Error)
+				<< "'" << name << "' needs " << width_ * height_
+				<< " gains";
+			return -EINVAL;
+		}
+		tables.push_back(std::move(*t));
+	}
+
+	gains_.resize(width_ * height_);
+	for (unsigned int i = 0; i < gains_.size(); i++)
+		gains_[i] = RGB<float>({ static_cast<float>(tables[0][i]),
+					 static_cast<float>(tables[1][i]),
+					 static_cast<float>(tables[2][i]) });
+
+	auto fade = tuningData["fadeGain"].get<std::vector<double>>();
+	if (fade) {
+		if (fade->size() != 2 || (*fade)[0] >= (*fade)[1]) {
+			LOG(IPASoftLsc, Error) << "Invalid 'fadeGain'";
+			return -EINVAL;
+		}
+		fadeStart_ = (*fade)[0];
+		fadeEnd_ = (*fade)[1];
+	}
+
+	return 0;
+}
+
+int Lsc::configure([[maybe_unused]] IPAContext &context,
+		   [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	uploaded_ = false;
+	return 0;
+}
+
+void Lsc::prepare(IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  DebayerParams *params)
+{
+	/* The mesh lives in the shared parameters, write it once per session. */
+	if (!uploaded_) {
+		std::copy(gains_.begin(), gains_.end(), params->lscGains.begin());
+		params->lscWidth = width_;
+		params->lscHeight = height_;
+		params->lscSeq = ++seq_;
+		uploaded_ = true;
+	}
+
+	float strength = 1.0f;
+	if (fadeEnd_ > 0.0)
+		strength = std::clamp((fadeEnd_ - context.activeState.agc.again) /
+				      (fadeEnd_ - fadeStart_), 0.0, 1.0);
+	params->lscStrength = strength;
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "Lsc")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
