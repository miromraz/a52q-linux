+/*
+ * Upload the lens shading mesh as an RGBA8 texture on unit 2, holding log2 of
+ * the gains scaled to the table's range: 8 bits then give ~0.3% steps for a
+ * 6x corner gain, and bilinear filtering interpolates between the nodes.
+ */
+void DebayerEGL::uploadLsc(const DebayerParams &params)
+{
+	const unsigned int n = params.lscWidth * params.lscHeight;
+	std::vector<uint8_t> texels(n * 4, 255);
+	float lo = INFINITY, hi = -INFINITY;
+
+	for (unsigned int i = 0; i < n; i++) {
+		for (unsigned int c = 0; c < 3; c++) {
+			float l = std::log2(std::max(params.lscGains[i][c], 1e-3f));
+			lo = std::min(lo, l);
+			hi = std::max(hi, l);
+		}
+	}
+	if (hi - lo < 1e-3f)
+		hi = lo + 1e-3f;
+
+	for (unsigned int i = 0; i < n; i++) {
+		for (unsigned int c = 0; c < 3; c++) {
+			float l = std::log2(std::max(params.lscGains[i][c], 1e-3f));
+			texels[i * 4 + c] = std::lround((l - lo) / (hi - lo) * 255.0f);
+		}
+	}
+
+	if (!lscTexture_)
+		glGenTextures(1, &lscTexture_);
+	glActiveTexture(GL_TEXTURE2);
+	glBindTexture(GL_TEXTURE_2D, lscTexture_);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, params.lscWidth, params.lscHeight,
+		     0, GL_RGBA, GL_UNSIGNED_BYTE, texels.data());
+
+	lscRange_[0] = lo;
+	lscRange_[1] = hi;
+	lscSeq_ = params.lscSeq;
+
+	LOG(Debayer, Debug) << "LSC mesh " << params.lscWidth << "x"
+			    << params.lscHeight << " log2 gain range "
+			    << lo << ".." << hi;
+}
