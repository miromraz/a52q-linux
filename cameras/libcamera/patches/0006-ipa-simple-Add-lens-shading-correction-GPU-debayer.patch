@@ -71,6 +71,19 @@ uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
 
+/* Lens shading mesh, nodes span the frame; stored as log2 gains in 8 bits. */
+uniform sampler2D tex_lsc;
+uniform vec2 lsc_grid;
+uniform vec2 lsc_range;
+uniform float lsc_strength;
+
+vec3 lsc_gain(vec2 pos)
+{
+	vec2 uv = (pos * (lsc_grid - 1.0) + 0.5) / lsc_grid;
+	vec3 l = lsc_range.x + texture2D(tex_lsc, uv).rgb * (lsc_range.y - lsc_range.x);
+	return mix(vec3(1.0), exp2(l), lsc_strength);
+}
