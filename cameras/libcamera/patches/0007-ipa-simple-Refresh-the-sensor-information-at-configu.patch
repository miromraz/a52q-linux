From 70a8cefcd79c0307e6d0b9bf0b95fc51547c2e62 Mon Sep 17 00:00:00 2001
From: a52q camera integration <jarda.kotesovec@proton.me>
Date: Sun, 27 Sep 2026 12:05:45 +0200
Subject: [PATCH 07/12] ipa: simple: Refresh the sensor information at
 configure time

The soft IPA only receives IPACameraSensorInfo in init(), which the
software ISP builds from the sensor format at pipeline creation. When
the application selects a different sensor mode the line length, frame
length and analogue crop in the IPA context are stale: the exposure
time reported in the metadata is computed from the wrong line duration,
and algorithms cannot tell which part of the pixel array the frame
covers.

Pass the sensor information of the configured mode in IPAConfigInfo and
store it in the context before the algorithms are configured.
---
 include/libcamera/ipa/soft.mojom         | 1 +
 src/ipa/simple/soft_simple.cpp           | 6 ++++++
 src/libcamera/pipeline/simple/simple.cpp | 3 +++
 3 files changed, 10 insertions(+)

diff --git a/include/libcamera/ipa/soft.mojom b/include/libcamera/ipa/soft.mojom
index 77328c5..9978826 100644
--- a/include/libcamera/ipa/soft.mojom
+++ b/include/libcamera/ipa/soft.mojom
@@ -10,6 +10,7 @@ import "include/libcamera/ipa/core.mojom";
 
 struct IPAConfigInfo {
 	libcamera.ControlInfoMap sensorControls;
+	libcamera.IPACameraSensorInfo sensorInfo;
 };
 
 interface IPASoftInterface {
diff --git a/src/ipa/simple/soft_simple.cpp b/src/ipa/simple/soft_simple.cpp
index 629e1a3..81d81d9 100644
--- a/src/ipa/simple/soft_simple.cpp
+++ b/src/ipa/simple/soft_simple.cpp
@@ -202,6 +202,12 @@ int IPASoftSimple::init(const IPASettings &settings,
 int IPASoftSimple::configure(const IPAConfigInfo &configInfo)
 {
 	sensorInfoMap_ = configInfo.sensorControls;
+	/*
+	 * The sensor information passed to init() describes the sensor mode
+	 * at pipeline creation time; line length, frame length and crop
+	 * depend on the mode selected by this configuration.
+	 */
+	context_.sensorInfo = configInfo.sensorInfo;
 
 	const ControlInfo &exposureInfo = sensorInfoMap_.find(V4L2_CID_EXPOSURE)->second;
 	const ControlInfo &gainInfo = sensorInfoMap_.find(V4L2_CID_ANALOGUE_GAIN)->second;
diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index e26f438..0797e48 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -1605,6 +1605,9 @@ int SimplePipelineHandler::configure(Camera *camera, CameraConfiguration *c)
 	} else {
 		ipa::soft::IPAConfigInfo configInfo;
 		configInfo.sensorControls = data->sensor_->controls();
+		ret = data->sensor_->sensorInfo(&configInfo.sensorInfo);
+		if (ret)
+			return ret;
 		return data->swIsp_->configure(inputCfg, outputCfgs, configInfo);
 	}
 }
