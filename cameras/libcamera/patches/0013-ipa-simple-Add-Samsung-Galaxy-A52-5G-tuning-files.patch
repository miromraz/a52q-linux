+# SPDX-License-Identifier: CC0-1.0
+#
+# libcamera 0.7.2 soft-ISP tuning for the MACRO camera of the Galaxy A52 5G
+# (GalaxyCore GC5035, cci1 0x3f, model "gc5035_macro", see REPORT.md).
+# Source: stock A525FXXUAFXL2 com.samsung.tuned.lsi_gc5035_macro.bin (CamX
+# Chromatix), decoded by chromatix_dump.py.
+# - blackLevel: bls12 offset 1024/16384 = 64 @ 10 bit (dark frames: 64.0..64.2).
+# - Ccm: cc13_ipe matrices of the indoor lux region (lux index 280..340).
+#   Stock keys are real CCTs from Qualcomm AWB; libcamera keys the CCM on
+#   estimateCCT() of the grey-world raw R/G, B/G, which reads low for this
+#   sensor. Keys = estimateCCT() of the sensor's raw white point per
+#   illuminant (stock AWB reference points anchored to this module's OTP
+#   white balance): H 2300K -> 2490, A 2856K -> 2820, TL84 4000K -> 3960,
+#   D50 5000K -> 4480, D65 6500K -> 5490.
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+      blackLevel: 4096
+  - Awb:
+  # lsc34_ife (tuned.lsi_gc5035_macro.bin), lux index 1..420, 17x13 nodes
+  # over the frame as streamed (macro/gc5035_macro-lsc.yaml).
+  # Vendor turns LSC off in low light (lux index > ~500); approximated by
+  # fading it out between analogue gain 8x and 16x.
+  - Lsc:
